# ==============================================================================
# Snoomp — Production Caddy Configuration (Automatic HTTPS & WebSockets)
# ==============================================================================
# Replace 'snoomp.example.com' with your actual domain name.
# Caddy automatically provisions and renews Let's Encrypt TLS certificates.
# ==============================================================================

snoomp.example.com {
    # Reverse proxy to local Snoomp container port
    reverse_proxy 127.0.0.1:8008 {
        # Caddy automatically proxies WebSockets by default
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }

    # Max request body size for database backups and exports (120MB)
    request_body {
        max_size 120MB
    }

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Gzip / Zstandard compression for static assets
    encode zstd gzip
}
