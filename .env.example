# Snoomp Environment Variables — DO NOT COMMIT THIS FILE
# Generate a new JWT_SECRET: python -c "import secrets; print(secrets.token_urlsafe(64))"

JWT_SECRET=CHANGE_ME_GENERATE_WITH_secrets_token_urlsafe_64
DATABASE_URL=postgresql://snoomp_admin:CHANGE_ME@db:5432/snoomp_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8008
