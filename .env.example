# Snoomp configuration — copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real values: an earlier JWT secret and
# database password reached the public repository and had to be treated as
# permanently compromised.

# ── Required ──────────────────────────────────────────────────────────────

# Signs session tokens. Anyone holding this can forge an admin session.
#   openssl rand -base64 48
JWT_SECRET=

# PostgreSQL password. Used by both the database and the app.
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────────────

POSTGRES_USER=snoomp_admin
POSTGRES_DB=snoomp_db

# Persistent host directory for PostgreSQL and Redis storage (immune to docker volume prune).
# Defaults to ./data within the Snoomp directory.
SNOOMP_DATA_DIR=./data

# Host port for the UI and API.
SNOOMP_PORT=8008

# Bind address on host. Use 0.0.0.0 for direct external access, or 127.0.0.1
# if running behind a reverse proxy (e.g. Nginx or Caddy) on the same host.
SNOOMP_BIND_IP=0.0.0.0

# Browser origins allowed to call the API. Because the frontend is served
# same-origin by the backend, this only needs the URL users actually visit.
# Include both the port and protocol:
#   ALLOWED_ORIGINS=http://10.100.244.3:8008,https://snoomp.example.com
ALLOWED_ORIGINS=http://localhost:8008

# Session lifetime in minutes (1440 = 24h).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Concurrent checks per worker. Raise for large fleets; each slot is one
# in-flight ping/SSH/SNMP connection.
CELERY_CONCURRENCY=8

# First-run admin password. Leave blank to have one generated and printed
# once to the container log:  docker compose logs api | grep -A5 FIRST-RUN
SNOOMP_ADMIN_PASSWORD=

# Optional default admin email for password recovery:
SNOOMP_ADMIN_EMAIL=

# ── SMTP / Email Server (Password Recovery) ─────────────────────────────────
# Configure SMTP to enable password reset link emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@snoomp.local
SMTP_TLS=true

# Public application URL used to construct the reset link in emails.
# If left blank, Snoomp detects the browser origin or defaults to http://localhost:8008.
APP_URL=http://localhost:8008

# Image tag applied at build time.
SNOOMP_VERSION=local
