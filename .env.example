# Snoomp Environment Variables — DO NOT COMMIT THIS FILE
# Generate a new JWT_SECRET: python -c "import secrets; print(secrets.token_urlsafe(64))"

JWT_SECRET=CHANGE_ME_GENERATE_WITH_secrets_token_urlsafe_64
DATABASE_URL=postgresql://snoomp_admin:CHANGE_ME@db:5432/snoomp_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8008

# --- Discord alerting (see docs/DISCORD-NOTIFICATIONS.md) ---
# Off by default. Set to 1 once both webhooks below are filled in.
DISCORD_ALERTS_ENABLED=0
# Channel > Edit Channel > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_CRITICAL=
DISCORD_WEBHOOK_WARNING=
# Numeric role ID pinged on DOWN alerts. Enable Developer Mode, then
# Server Settings > Roles > OnCall > ... > Copy Role ID. Leave blank for no ping.
DISCORD_ONCALL_ROLE_ID=
# Seconds between queue flushes, and max alerts held per channel.
DISCORD_FLUSH_INTERVAL=10
DISCORD_QUEUE_MAX=500
